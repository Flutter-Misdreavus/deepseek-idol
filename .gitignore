assets/music/
# 日文原词相关文本
assets/lyrics/歌词_*.txt
# 歌曲音频（渲染输入，需自行放置 song.mp3）
mv/public/audio/
# Live2D 模型渲染帧序列（模型的演绎作品，且体积极大）
mv/public/l2d/
# Live2D Cubism Core，Live2D Inc. 专有许可，请从官网获取
live2d-render/vendor/
# 官方 MV 截图等第三方参考素材
gen/ref/
# 基于 Live2D 模型形象（CC BY-NC-SA 4.0）生成的角色图，属演绎作品
gen/g0/*.png
gen/m1/*.png
mv/public/img/
# 含日文原词，由 tools/build_lyrics.py 重新生成
mv/src/data/lyrics.json

# ============ 生成产物 / 中间产物 ============
# 渲染输出与校样
out/
# OCR 中间产物
.work/
# codex 运行日志（含本机路径 / session id）
*.log
# 由 tools/analyze_audio.py 重新生成
mv/src/data/beats.json

