# ============ 依赖 ============
node_modules/
# vendored Python 环境 (yt-dlp / PyObjC)，用 pip 自行安装
.tools/py/
__pycache__/
*.pyc

# ============ 版权内容：不入库，请自行准备（见 README） ============
